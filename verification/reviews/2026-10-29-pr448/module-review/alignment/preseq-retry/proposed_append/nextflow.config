process { executor='local'; cpus=1; memory='1 GB'; maxRetries=1; maxErrors=-1; errorStrategy='finish'; ext.args='-verbose -bam -seed 1'; withLabel:error_ignore { errorStrategy='ignore' }; withLabel:error_retry { errorStrategy='retry'; maxRetries=2 } }
conda.enabled=false
docker.enabled=false
nextflow.enable.telemetry=false

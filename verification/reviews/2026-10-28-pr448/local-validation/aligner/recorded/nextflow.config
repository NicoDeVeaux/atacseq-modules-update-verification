params.case = 'current'
params.outdir = "${projectDir}/out/${params.case}"
params.publish_dir_mode = 'copy'
params.aligner = 'chromap'
params.seq_center = 'Test Centre'
params.save_align_intermeds = true
params.maxFragmentLength = 0
params.minFragmentLength = 0
includeConfig "REVIEW_ROOT/source/conf/modules.config"
docker.enabled = true
process.executor = 'local'
process.cpus = 1
process.memory = '1 GB'
process.container = 'community.wave.seqera.io/library/picard:3.4.0--e9963040df0a9bf6'
process.errorStrategy = 'terminate'
profiles {
  old {
    process {
      withName: 'PICARD_MERGESAMFILES_LIBRARY|PICARD_MARKDUPLICATES' {
        container = 'quay.io/biocontainers/picard:3.1.1--hdfd78af_0'
      }
    }
  }
  fixed {
    process {
      withName: '.*:FASTQ_ALIGN_CHROMAP:PICARD_ADDORREPLACEREADGROUPS' {
        ext.args = { "--RGID ${meta.id} --RGSM ${meta.id - ~/_T\d+$/} --RGPL ILLUMINA --RGLB ${meta.id - ~/_T\d+$/} --RGPU 1" }
      }
    }
  }
}
